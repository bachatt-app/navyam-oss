# infra.env.example — cloud identifiers used by Navya ops/deploy scripts.
#
# These are NOT secrets (no credentials here — auth is via `az login` /
# `gcloud auth` / managed identity). They are account/resource identifiers kept
# out of the public repo so we don't publish our exact cloud topology.
#
# Setup: copy to `infra.env` (gitignored) and fill in your real values:
#     cp infra.env.example infra.env && $EDITOR infra.env
# Ops scripts auto-source infra.env from the repo root (and $HOME/infra.env on
# remote boxes). Every value below is referenced as ${VAR} in the scripts.

# ---- Azure ----
export AZ_STORAGE_ACCOUNT=your-storage-account      # blob account holding model checkpoints
export AZ_A10_VM=your-a10-vm                         # inference VM name
export AZ_A10_RG=your-a10-rg                         # resource group of the A10 VM
export AZ_A10_IP=YOUR_A10_IP                         # A10 public IP (origin behind the API domain)
export AZ_WEBAPP_RG=your-webapp-rg                   # resource group of the web apps
export AZ_WEBAPP_CONSUMER=your-consumer-webapp       # consumer web app name
export AZ_WEBAPP_ADMIN=your-admin-webapp             # admin web app name
export AZ_AKS_RG=your-aks-rg                         # AKS resource group
export AZ_H1_STORAGE=your-h1-storage                 # H100-window stream storage account

# ---- GCP ----
export GCP_PROJECT=your-gcp-project                  # GCP project id (A100 compute)
export GCP_ACCOUNT=you@example.com                   # gcloud user account
export GCS_STAGING_BUCKET=your-staging-bucket        # GCS bucket for A100 staging
export GCS_UKTI_BUCKET=your-ukti-bucket              # GCS bucket (secondary)

# ---- API ----
export API_HOST=api.example.ai                       # public inference API host
export GCS_CORPUS_BUCKET=your-corpus-bucket        # GCS bucket for the training corpus
